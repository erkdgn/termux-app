<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/partial_primary_toolbar"
        android:id="@+id/partial_primary_toolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/linux_distro"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <Spinner
                android:id="@+id/linux_distro_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/linux_alias_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/linux_alias">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/linux_alias_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/linux_user_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/linux_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/linux_user_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_sudo_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_sudo" />

            <TextView
                android:id="@+id/linux_sudo_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorError"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_basic_tools_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/linux_basic_tools" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_ssh_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_ssh" />

            <LinearLayout
                android:id="@+id/linux_ssh_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/linux_port_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/linux_ssh_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/linux_port_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="5"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/linux_autostart_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/linux_ssh_autostart" />

                <TextView
                    android:id="@+id/linux_ssh_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorError"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/linux_version"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <Spinner
                android:id="@+id/linux_version_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/linux_version_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorError"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/linux_timezone"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <Spinner
                android:id="@+id/linux_timezone_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/linux_timezone_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorError"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_locale_tr_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_locale_tr" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/linux_hostname_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/linux_hostname">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/linux_hostname_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/linux_packages"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_group_dev_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_group_dev" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_group_python_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_group_python" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_group_nodejs_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_group_nodejs" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_group_nginx_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_group_nginx" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_group_postgresql_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_group_postgresql" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_group_mariadb_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_group_mariadb" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/linux_extra_packages_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/linux_extra_packages">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/linux_extra_packages_edit"
                    android:hint="@string/linux_extra_packages_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/linux_root_access"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/linux_root_password_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/linux_root_password" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/linux_root_key_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/linux_root_key">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/linux_root_key_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/linux_user_key_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/linux_user_key"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/linux_user_key_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/linux_phantom_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/linux_phantom_note"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <Button
                    android:id="@+id/linux_developer_options_button"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/linux_developer_options" />
            </LinearLayout>

            <Button
                android:id="@+id/linux_install_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:text="@string/linux_install" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
